location ~ ^/nomad-oasis/gui/(?:user/uploads/upload/id|upload/id|user/search/upload/id)/(?<project_id>[^/]+)/files/(?<file_path>.+)$ {
    if ($cookie_nomad_gui_pref = "v1") { return 302 /gui/user/uploads/upload/id/$project_id/files/$file_path$is_args$args; }
