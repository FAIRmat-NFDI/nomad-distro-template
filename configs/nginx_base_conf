location ~ ^/nomad-oasis/gui/v2(?:/(?<v2_path>.*))?$ {
    return 302 /$v2_path$is_args$args;
}

# Other old GUI routes retain their path for v1. Unknown v2 routes fall back
# to the v2 home instead of claiming an unsafe arbitrary redirect.
location ~ ^/nomad-oasis/gui(?:/(?<legacy_gui_path>.*))?$ {
    if ($cookie_nomad_gui_pref = "v1") { return 302 /gui/$legacy_gui_path$is_args$args; }
    if ($cookie_nomad_gui_pref = "v2") { return 302 /$is_args$args; }
    return 302 /select-gui$is_args$args;
}

# This must be an anchored regex, and it must appear before the generic
# /api/v1 regex locations below. A normal prefix location is insufficient:
# those regexes also match the old path and would bypass the compatibility
# rewrite for uploads and downloads.
location ~ ^/nomad-oasis/(?:api|north|optimade|dcat|h5grove|dashboards|docs|metrics|alive|temporal)(?:/|$) {
    rewrite ^/nomad-oasis/(.*)$ /backend/$1 last;
}

# All remaining non-GUI routes under the old base path belonged to the backend
# (including arbitrary API entry-point prefixes).
location = /nomad-oasis {
    return 302 /$is_args$args;
}

location = /nomad-oasis/ {
    return 302 /$is_args$args;
}

location /nomad-oasis/ {
    rewrite ^/nomad-oasis/(.*)$ /backend/$1 last;
}

location = /docs {
    return 302 /backend/docs/;
}

location /docs/ {
    rewrite ^/docs/(.*)$ /backend/docs/$1 redirect;
}

location /backend/docs/ {
    # This is added to force a redirect (302) when 404 otherwise
    # the assets are not loaded correctly (a broken page rendered)
    proxy_intercept_errors on;
    error_page 404 = @docs404redirect;
    proxy_pass http://nomad-app-backend;
}

location @docs404redirect {
    return 302 /backend/docs/404.html;
}

location ~ \/gui\/(service-worker\.js|meta\.json)$ {
    add_header Last-Modified $date_gmt;
    add_header Cache-Control 'no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0';
    if_modified_since off;
    expires off;
    etag off;
    proxy_pass http://nomad-app-backend;
}

# Match downloads before the broader raw-file upload rule below.
location ~ /api/v1/(.*/download|uploads/[^/]+/export/?$) {
    proxy_buffering off;
    proxy_pass http://nomad-app-backend;
}

# Legacy bundle endpoints support both imports and exports.
location ~ /api/v1/uploads/[^/]+/bundle/?$ {
    client_max_body_size 35g;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_pass http://nomad-app-backend;
}

# Stream uploads and imports without buffering the request.
location ~ /api/v1/uploads(/?$|/import/?$|/[^/]+/raw(/|$)) {
    client_max_body_size 35g;
    proxy_request_buffering off;
    proxy_pass http://nomad-app-backend;
}

location /backend/north/ {
    client_max_body_size 500m;
    proxy_pass http://north:9000;

    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    # websocket headers
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header X-Scheme $scheme;

    proxy_buffering off;
}
