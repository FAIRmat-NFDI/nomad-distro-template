# Shared nginx config for both HTTP and HTTPS
#
# URL layout:
#   /             GUI v2 (with /select-gui and the nomad_gui_pref cookie)
#   /gui/         GUI v1
#   /backend/     NOMAD backend (API, north, docs, alive, ...)
#   /nomad-oasis/ Former base path, redirected/rewritten to the layout above

# Batch access-log writes instead of one synchronous write per request
access_log /var/log/nginx/access.log main buffer=64k flush=5s;

# Keep redirects relative so they do not depend on the listening port/scheme.
absolute_redirect off;

gzip_min_length     1000;
gzip_buffers        4 8k;
gzip_http_version   1.0;
gzip_disable        "msie6";
gzip_vary           on;
gzip on;
gzip_proxied any;
gzip_types
    text/css
    text/javascript
    text/xml
    text/plain
    application/javascript
    application/x-javascript
    application/json;

# The GUI owns the root path. NOMAD and all other backend services are
# mounted below /backend.
location = / {
    error_page 418 = @serve_clean_root_v2;
    if ($cookie_nomad_gui_pref = "v1") {
        return 302 /gui/$is_args$args;
    }
    if ($cookie_nomad_gui_pref = "v2") {
        return 418;
    }
    return 302 /select-gui$is_args$args;
}

location @serve_clean_root_v2 {
    rewrite ^ /backend/gui/v2/ break;
    proxy_intercept_errors on;
    error_page 404 = @redirect_clean_root_to_v2_index;
    proxy_pass http://nomad-app-backend;
}

# Explicit GUI paths never consult the preference cookie.
location = /gui {
    return 302 /gui/$is_args$args;
}

location = /gui/v2 {
    return 302 /$is_args$args;
}

location /gui/v2/ {
    rewrite ^/gui/v2/(.*)$ /$1 permanent;
}

# env.js is generated at runtime and intentionally keeps the backend appBase
# (/backend). Do not apply the public GUI base substitution to it or the
# classical GUI will call APIs below the public GUI route again.
location = /gui/env.js {
    rewrite ^/gui/env\.js$ /backend/gui/env.js break;
    proxy_pass http://nomad-app-backend;
}

location = /gui/artifacts.js {
    rewrite ^/gui/artifacts\.js$ /backend/gui/artifacts.js break;
    proxy_pass http://nomad-app-backend;
}

# The classical GUI (v1) is prepared by NOMAD with the backend route prefix.
# Replace only its frontend base in static responses so browser routing stays
# below the public /gui path. Disable upstream compression while filtering;
# nginx can gzip the substituted response afterwards.
location ^~ /gui/ {
    rewrite ^/gui/(.*)$ /backend/gui/$1 break;
    proxy_set_header Accept-Encoding "";
    sub_filter '/backend/gui' '/gui';
    sub_filter_types text/css text/javascript application/javascript application/x-javascript application/json;
    sub_filter_once off;
    proxy_redirect ~^(?:https?://[^/]+)?/backend/gui/(.*)$ /gui/$1;
    proxy_intercept_errors on;
    error_page 404 = @redirect_public_v1_to_index;
    proxy_pass http://nomad-app-backend;
}

location @redirect_public_v1_to_index {
    rewrite ^ /backend/gui/index.html break;
    proxy_set_header Accept-Encoding "";
    sub_filter '/backend/gui' '/gui';
    sub_filter_types text/css text/javascript application/javascript application/x-javascript application/json;
    sub_filter_once off;
    proxy_pass http://nomad-app-backend;
}

# One reserved subtree owns every backend URL. More-specific API regex
# locations below still win for uploads and downloads.
location = /backend {
    proxy_pass http://nomad-app-backend;
}

location /backend/ {
    proxy_pass http://nomad-app-backend;
}

location = /backend/north {
    return 302 /backend/north/$is_args$args;
}

# Everything else below the root belongs to the GUI v2. This proxy-side
# rewrite reaches the backend's v2 mount without re-running location matching.
location / {
    rewrite ^/(.*)$ /backend/gui/v2/$1 break;
    proxy_intercept_errors on;
    error_page 404 = @redirect_clean_root_to_v2_index;
    proxy_pass http://nomad-app-backend;
}

location @redirect_clean_root_to_v2_index {
    rewrite ^ /backend/gui/v2/index.html break;
    proxy_pass http://nomad-app-backend;
}

# Former /nomad-oasis URLs. Old GUI links are redirected to the GUI chosen by
# the preference cookie, or to the GUI selector. Old API/service URLs are
# internally rewritten. `last` starts a new location search, retaining the
# original method, request body and headers.
location ~ ^/nomad-oasis/gui/search/entries/?$ {
    if ($cookie_nomad_gui_pref = "v1") { return 302 /gui/search/entries$is_args$args; }
    if ($cookie_nomad_gui_pref = "v2") { return 302 /apps/entries$is_args$args; }
    return 302 /select-gui?destination=entries$gui_selector_args;
}

location ~ ^/nomad-oasis/gui/search/(?<app_name>[^/]+)/entry/id/(?<entry_id>[^/?]+)(?<rest_path>.*)$ {
    set $v2_entry_suffix '';
    if ($rest_path = /data) { set $v2_entry_suffix /archive; }
    if ($rest_path ~ ^/data/(.*)$) { set $v2_entry_suffix /archive/$1; }
    if ($rest_path = /logs) { set $v2_entry_suffix /logs; }
    if ($cookie_nomad_gui_pref = "v1") { return 302 /gui/search/$app_name/entry/id/$entry_id$rest_path$is_args$args; }
    if ($cookie_nomad_gui_pref = "v2") { return 302 /apps/$app_name/$entry_id$v2_entry_suffix$is_args$args; }
    return 302 /select-gui?destination=entry&entryId=$entry_id&appId=$app_name$gui_selector_args$gui_selector_entry_fragment;
}

location ~ ^/nomad-oasis/gui/search/(?<app_name>[^/?]+)/?$ {
    if ($cookie_nomad_gui_pref = "v1") { return 302 /gui/search/$app_name$is_args$args; }
    if ($cookie_nomad_gui_pref = "v2") { return 302 /apps/$app_name$is_args$args; }
    return 302 /select-gui?destination=app&appId=$app_name$gui_selector_args;
}

location ~ ^/nomad-oasis/gui/search/?$ {
    if ($cookie_nomad_gui_pref = "v1") { return 302 /gui/search$is_args$args; }
    if ($cookie_nomad_gui_pref = "v2") { return 302 /apps/entries$is_args$args; }
    return 302 /select-gui?destination=entries$gui_selector_args;
}

location ~ ^/nomad-oasis/gui/entry/id/(?<entry_id>[^/?]+)(?<rest_path>.*)$ {
    set $v2_entry_suffix '';
    if ($rest_path = /data) { set $v2_entry_suffix /archive; }
    if ($rest_path ~ ^/data/(.*)$) { set $v2_entry_suffix /archive/$1; }
    if ($rest_path = /logs) { set $v2_entry_suffix /logs; }
    if ($cookie_nomad_gui_pref = "v1") { return 302 /gui/entry/id/$entry_id$rest_path$is_args$args; }
    if ($cookie_nomad_gui_pref = "v2") { return 302 /apps/entries/$entry_id$v2_entry_suffix$is_args$args; }
    return 302 /select-gui?destination=entry&entryId=$entry_id$gui_selector_args$gui_selector_entry_fragment;
}

